{
  "http-enabled": true,
  "http-host": "0.0.0.0",
  "http-port": 7860,
  "https-enabled": false,
  "wss-enabled": false,
  "web-ui-enabled": true,
  "web-ui-auth-enabled": false,
  "web-ui-require-https": false,
  "log-file": "/tmp/gitautodeploy.log",
  "pid-file": "/tmp/gitautodeploy.pid",
  "log-level": "INFO",

  "repositories": [
    {
      "url": "https://github.com/your-org/repo-1.git",
      "branch": "main",
      "remote": "origin",
      "path": "/app/repositories/repo-1",
      "deploy": "python3 scripts/deploy_to_hf.py --repo-path . --space-id your-org/space-1 --branch main",
      "huggingface_space": "your-org/space-1",
      "report_to_jules": true
    },
    {
      "url": "https://github.com/your-org/repo-2.git",
      "branch": "main",
      "remote": "origin",
      "path": "/app/repositories/repo-2",
      "deploy": "python3 scripts/deploy_to_hf.py --repo-path . --space-id your-org/space-2 --branch main",
      "huggingface_space": "your-org/space-2",
      "report_to_jules": true
    }
  ]
}
