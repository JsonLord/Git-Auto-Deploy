{
  "http-enabled": true,
  "http-host": "0.0.0.0",
  "http-port": 7860,
  "https-enabled": false,
  "wss-enabled": false,
  "web-ui-enabled": true,
  "web-ui-auth-enabled": false,
  "web-ui-require-https": false,
  "log-file": "/tmp/gitautodeploy.log",
  "pid-file": "/tmp/gitautodeploy.pid",
  "log-level": "INFO",
  "repositories": [
    {
      "url": "https://github.com/JsonLord/Git-Auto-Deploy.git",
      "branch": "master",
      "remote": "origin",
      "path": "/app/repositories/git-auto-deploy",
      "deploy": "python3 scripts/agentic_deploy.py --repo-path . --space-id harvesthealth/magnetic-ui --branch master --github-repo JsonLord/Git-Auto-Deploy --token $HF_TOKEN --openai-token $BLABLADOR_API_KEY",
      "huggingface_space": "harvesthealth/magnetic-ui",
      "report_to_jules": true,
      "github_repo": "JsonLord/Git-Auto-Deploy"
    }
  ]
}
